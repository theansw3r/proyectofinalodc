class MazeGame {
    field MazeMap map;
    field Player player;
    field Enemy enemy;

    field int state;
    field int cellSize;
    field boolean exit;

    field int tickCounter;
    field int enemySpeed;
    field int enemySpawnOption;

    field int lastKey;

    field String startMsg;
    field String pauseMsg;
    field String winMsg;
    field String loseMsg;
    field String restartMsg;

    constructor MazeGame new() {
        let map = MazeMap.new();
        let player = Player.new(map.getStartRow(), map.getStartCol());
        let enemy = Enemy.new(map.getEnemySpawnRow(0), map.getEnemySpawnCol(0));

        let state = 0;      // 0=start, 1=playing, 2=paused, 3=win, 4=lose
        let cellSize = 12;
        let exit = false;

        let tickCounter = 0;
        let enemySpeed = 3;
        let enemySpawnOption = 0;
        let lastKey = 0;

        let startMsg = "PRESS ANY KEY TO START";
        let pauseMsg = "PAUSED - PRESS P TO RESUME";
        let winMsg = "YOU WIN!";
        let loseMsg = "GAME OVER";
        let restartMsg = "PRESS R TO RESTART";

        return this;
    }

    method void dispose() {
        do startMsg.dispose();
        do pauseMsg.dispose();
        do winMsg.dispose();
        do loseMsg.dispose();
        do restartMsg.dispose();

        do enemy.dispose();
        do player.dispose();
        do map.dispose();
        do Memory.deAlloc(this);
        return;
    }

    method void drawBigMazemanTitle() {
        do drawM(40, 20);
        do drawA(95, 20);
        do drawZ(150, 20);
        do drawE(205, 20);
        do drawM(260, 20);
        do drawA(315, 20);
        do drawN(370, 20);
        return;
    }

    method void drawM(int x, int y) {
        do Screen.drawRectangle(x, y, x + 6, y + 50);
        do Screen.drawRectangle(x + 30, y, x + 36, y + 50);
        do Screen.drawRectangle(x + 8, y, x + 13, y + 15);
        do Screen.drawRectangle(x + 14, y + 10, x + 19, y + 25);
        do Screen.drawRectangle(x + 20, y, x + 25, y + 15);
        return;
    }

    method void drawA(int x, int y) {
        do Screen.drawRectangle(x, y + 10, x + 6, y + 50);
        do Screen.drawRectangle(x + 30, y + 10, x + 36, y + 50);
        do Screen.drawRectangle(x + 8, y, x + 28, y + 6);
        do Screen.drawRectangle(x + 8, y + 24, x + 28, y + 30);
        return;
    }

    method void drawZ(int x, int y) {
        do Screen.drawRectangle(x, y, x + 36, y + 6);
        do Screen.drawRectangle(x, y + 44, x + 36, y + 50);
        do Screen.drawRectangle(x + 28, y + 8, x + 34, y + 14);
        do Screen.drawRectangle(x + 22, y + 15, x + 28, y + 21);
        do Screen.drawRectangle(x + 16, y + 22, x + 22, y + 28);
        do Screen.drawRectangle(x + 10, y + 29, x + 16, y + 35);
        do Screen.drawRectangle(x + 4, y + 36, x + 10, y + 42);
        return;
    }

    method void drawE(int x, int y) {
        do Screen.drawRectangle(x, y, x + 6, y + 50);
        do Screen.drawRectangle(x, y, x + 34, y + 6);
        do Screen.drawRectangle(x, y + 22, x + 28, y + 28);
        do Screen.drawRectangle(x, y + 44, x + 34, y + 50);
        return;
    }

    method void drawN(int x, int y) {
        do Screen.drawRectangle(x, y, x + 6, y + 50);
        do Screen.drawRectangle(x + 30, y, x + 36, y + 50);
        do Screen.drawRectangle(x + 8, y + 2, x + 13, y + 12);
        do Screen.drawRectangle(x + 14, y + 10, x + 19, y + 20);
        do Screen.drawRectangle(x + 20, y + 18, x + 25, y + 28);
        do Screen.drawRectangle(x + 26, y + 26, x + 30, y + 36);
        return;
    }

    method void drawStartScreen() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        do drawBigMazemanTitle();
        do Output.moveCursor(18, 21);
        do Output.printString(startMsg);
        return;
    }

    method void drawPauseScreen() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        do Output.moveCursor(10, 11);
        do Output.printString(pauseMsg);
        return;
    }

    method void drawWinScreen() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        do Output.moveCursor(9, 15);
        do Output.printString(winMsg);
        do Output.moveCursor(13, 12);
        do Output.printString(restartMsg);
        return;
    }

    method void drawLoseScreen() {
        do Screen.clearScreen();
        do Screen.setColor(true);
        do Output.moveCursor(9, 14);
        do Output.printString(loseMsg);
        do Output.moveCursor(13, 12);
        do Output.printString(restartMsg);
        return;
    }

    method void drawPlayingScreen() {
        do Screen.clearScreen();
        do map.draw(cellSize);
        do player.draw(cellSize);
        do enemy.draw(cellSize);
        return;
    }

    method void initializeEnemySpawn() {
        let enemySpawnOption = Random.randRange(3);
        do enemy.setPosition(
            map.getEnemySpawnRow(enemySpawnOption),
            map.getEnemySpawnCol(enemySpawnOption)
        );
        return;
    }

    method void restartGame() {
        do player.setPosition(map.getStartRow(), map.getStartCol());
        do initializeEnemySpawn();
        let tickCounter = 0;
        let lastKey = 0;
        let state = 1;
        return;
    }

    method void tryMovePlayer(int newRow, int newCol) {
        if (~map.isWall(newRow, newCol)) {
            do player.setPosition(newRow, newCol);

            if (map.isGoal(newRow, newCol)) {
                let state = 3;
            }
        }
        return;
    }

    method void handleNewKey(char key) {
        var int r, c;

        let r = player.getRow();
        let c = player.getCol();

        // P = pausa
        if (key = 80) {
            let state = 2;
            return;
        }

        // Flechas
        if (key = 130) {
            do tryMovePlayer(r, c - 1);
        }
        if (key = 131) {
            do tryMovePlayer(r - 1, c);
        }
        if (key = 132) {
            do tryMovePlayer(r, c + 1);
        }
        if (key = 133) {
            do tryMovePlayer(r + 1, c);
        }

        return;
    }

    method void updateEnemy() {
        var int nextRow, nextCol;

        let tickCounter = tickCounter + 1;

        if (tickCounter > enemySpeed) {
            let tickCounter = 0;

            let nextRow = AIHelper.nextRow(
                enemy.getRow(),
                enemy.getCol(),
                player.getRow(),
                player.getCol(),
                map
            );

            let nextCol = AIHelper.nextCol(
                enemy.getRow(),
                enemy.getCol(),
                player.getRow(),
                player.getCol(),
                map
            );

            if (~map.isWall(nextRow, nextCol)) {
                do enemy.setPosition(nextRow, nextCol);
            }
        }

        return;
    }

    method void checkLoseCondition() {
        if ((player.getRow() = enemy.getRow()) & (player.getCol() = enemy.getCol())) {
            let state = 4;
        }
        return;
    }

    method void run() {
        var char key;
        var int currentState;

        do drawStartScreen();
        do Random.seed();
        do initializeEnemySpawn();
        let state = 1;

        while (~exit) {
            let key = Keyboard.keyPressed();
            let currentState = state;

            if (currentState = 1) {
                if (~(key = lastKey)) {
                    if (~(key = 0)) {
                        do handleNewKey(key);
                    }
                }

                if (state = 1) {
                    do updateEnemy();
                    do checkLoseCondition();
                    do drawPlayingScreen();
                }

                do Sys.wait(60);
            }

            if (currentState = 2) {
                do drawPauseScreen();

                if (~(key = lastKey)) {
                    if (key = 80) {
                        let state = 1;
                    }
                }

                do Sys.wait(40);
            }

            if (currentState = 3) {
                do drawWinScreen();

                if (~(key = lastKey)) {
                    if (key = 82) {
                        do restartGame();
                    }
                }

                do Sys.wait(40);
            }

            if (currentState = 4) {
                do drawLoseScreen();

                if (~(key = lastKey)) {
                    if (key = 82) {
                        do restartGame();
                    }
                }

                do Sys.wait(40);
            }

            let lastKey = key;
        }

        return;
    }
}
