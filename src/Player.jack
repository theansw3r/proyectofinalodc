// Player.jack
// Representa al jugador en el laberinto.

class Player {
    field int row, col;

    constructor Player new(int startRow, int startCol) {
        let row = startRow;
        let col = startCol;
        return this;
    }

    method void dispose() {
        do Memory.deAlloc(this);
        return;
    }

    method int getRow() { return row; }
    method int getCol() { return col; }

    method void setPosition(int newRow, int newCol) {
        let row = newRow;
        let col = newCol;
        return;
    }

    method void draw(int cellSize) {
        var int x, y;
        var int mapWidth, mapHeight, offsetX, offsetY;

        let mapWidth  = 32 * cellSize;
        let mapHeight = 16 * cellSize;

        let offsetX = (512 - mapWidth) / 2;
        let offsetY = (256 - mapHeight) / 2;

        let x = offsetX + (col * cellSize);
        let y = offsetY + (row * cellSize);

        do Screen.setColor(true);
        do Screen.drawRectangle(x + 2, y + 2, x + cellSize - 4, y + cellSize - 4);

        do Screen.setColor(false);
        do Screen.drawRectangle(x + (cellSize / 2), y + 4, x + cellSize - 2, y + cellSize - 5);

        return;
    }
}
