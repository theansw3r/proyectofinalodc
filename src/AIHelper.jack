class AIHelper {
    function int abs(int x) {
        if (x < 0) {
            return -x;
        }
        return x;
    }

    function int manhattan(int r1, int c1, int r2, int c2) {
        return AIHelper.abs(r1 - r2) + AIHelper.abs(c1 - c2);
    }

    function int nextRow(int er, int ec, int pr, int pc, MazeMap map) {
        var int bestRow, bestCol;
        var int bestDist, currentDist;

        let bestRow = er;
        let bestCol = ec;
        let bestDist = AIHelper.manhattan(er, ec, pr, pc);

        if (~map.isWall(er - 1, ec)) {
            let currentDist = AIHelper.manhattan(er - 1, ec, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er - 1;
                let bestCol = ec;
            }
        }

        if (~map.isWall(er, ec - 1)) {
            let currentDist = AIHelper.manhattan(er, ec - 1, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er;
                let bestCol = ec - 1;
            }
        }

        if (~map.isWall(er, ec + 1)) {
            let currentDist = AIHelper.manhattan(er, ec + 1, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er;
                let bestCol = ec + 1;
            }
        }

        if (~map.isWall(er + 1, ec)) {
            let currentDist = AIHelper.manhattan(er + 1, ec, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er + 1;
                let bestCol = ec;
            }
        }

        return bestRow;
    }

    function int nextCol(int er, int ec, int pr, int pc, MazeMap map) {
        var int bestRow, bestCol;
        var int bestDist, currentDist;

        let bestRow = er;
        let bestCol = ec;
        let bestDist = AIHelper.manhattan(er, ec, pr, pc);

        if (~map.isWall(er - 1, ec)) {
            let currentDist = AIHelper.manhattan(er - 1, ec, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er - 1;
                let bestCol = ec;
            }
        }

        if (~map.isWall(er, ec - 1)) {
            let currentDist = AIHelper.manhattan(er, ec - 1, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er;
                let bestCol = ec - 1;
            }
        }

        if (~map.isWall(er, ec + 1)) {
            let currentDist = AIHelper.manhattan(er, ec + 1, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er;
                let bestCol = ec + 1;
            }
        }

        if (~map.isWall(er + 1, ec)) {
            let currentDist = AIHelper.manhattan(er + 1, ec, pr, pc);
            if (currentDist < bestDist) {
                let bestDist = currentDist;
                let bestRow = er + 1;
                let bestCol = ec;
            }
        }

        return bestCol;
    }
}