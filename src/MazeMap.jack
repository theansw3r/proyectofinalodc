class MazeMap {
    field int rows, cols;
    field Array cells;

    constructor MazeMap new() {
        let rows = 16;
        let cols = 32;
        let cells = Array.new(rows * cols);
        do initMap();
        return this;
    }

    method void dispose() {
        do cells.dispose();
        do Memory.deAlloc(this);
        return;
    }

    method int getRows() {
        return rows;
    }

    method int getCols() {
        return cols;
    }

    method int indexOf(int r, int c) {
        return (r * cols) + c;
    }

    method void setCell(int r, int c, int value) {
        let cells[indexOf(r, c)] = value;
        return;
    }

    method int getCell(int r, int c) {
        return cells[indexOf(r, c)];
    }

    method boolean isInside(int r, int c) {
        if ((r < 0) | (c < 0)) {
            return false;
        }
        if ((r > (rows - 1)) | (c > (cols - 1))) {
            return false;
        }
        return true;
    }

    method boolean isWall(int r, int c) {
        if (~isInside(r, c)) {
            return true;
        }
        return (getCell(r, c) = 1);
    }

    method boolean isGoal(int r, int c) {
        if (~isInside(r, c)) {
            return false;
        }
        return (getCell(r, c) = 2);
    }

    method int getStartRow() {
        return 13;
    }

    method int getStartCol() {
        return 2;
    }

    method int getEnemySpawnRow(int option) {
        if (option = 0) { return 7; }
        if (option = 1) { return 7; }
        if (option = 2) { return 8; }
        return 8;
    }

    method int getEnemySpawnCol(int option) {
        if (option = 0) { return 14; }
        if (option = 1) { return 17; }
        if (option = 2) { return 14; }
        return 17;
    }

    method void initMap() {
        var int r, c;

        let r = 0;
        while (r < rows) {
            let c = 0;
            while (c < cols) {
                do setCell(r, c, 1);
                let c = c + 1;
            }
            let r = r + 1;
        }

        let c = 1;
        while (c < 31) {
            do setCell(1, c, 0);
            do setCell(14, c, 0);
            let c = c + 1;
        }

        let r = 1;
        while (r < 15) {
            do setCell(r, 1, 0);
            do setCell(r, 30, 0);
            let r = r + 1;
        }

        let c = 3;
        while (c < 29) {
            do setCell(3, c, 0);
            do setCell(6, c, 0);
            do setCell(9, c, 0);
            do setCell(12, c, 0);
            let c = c + 1;
        }

        let r = 2;
        while (r < 14) {
            do setCell(r, 4, 0);
            do setCell(r, 9, 0);
            do setCell(r, 14, 0);
            do setCell(r, 17, 0);
            do setCell(r, 22, 0);
            do setCell(r, 27, 0);
            let r = r + 1;
        }

        do setCell(7, 0, 0);
        do setCell(7, 1, 0);
        do setCell(8, 0, 0);
        do setCell(8, 1, 0);

        do setCell(7, 30, 0);
        do setCell(7, 31, 0);
        do setCell(8, 30, 0);
        do setCell(8, 31, 0);

        do setCell(7, 13, 0);
        do setCell(7, 14, 0);
        do setCell(7, 15, 0);
        do setCell(7, 16, 0);
        do setCell(7, 17, 0);
        do setCell(7, 18, 0);

        do setCell(8, 13, 0);
        do setCell(8, 14, 0);
        do setCell(8, 15, 0);
        do setCell(8, 16, 0);
        do setCell(8, 17, 0);
        do setCell(8, 18, 0);

        do setCell(6, 15, 0);
        do setCell(6, 16, 0);
        do setCell(9, 15, 0);
        do setCell(9, 16, 0);

        do setCell(2, 6, 0);
        do setCell(2, 7, 0);
        do setCell(2, 8, 0);

        do setCell(2, 23, 0);
        do setCell(2, 24, 0);
        do setCell(2, 25, 0);

        do setCell(4, 6, 0);
        do setCell(4, 7, 0);
        do setCell(4, 8, 0);

        do setCell(4, 23, 0);
        do setCell(4, 24, 0);
        do setCell(4, 25, 0);

        do setCell(5, 11, 0);
        do setCell(5, 12, 0);
        do setCell(5, 19, 0);
        do setCell(5, 20, 0);

        do setCell(10, 11, 0);
        do setCell(10, 12, 0);
        do setCell(10, 19, 0);
        do setCell(10, 20, 0);

        do setCell(11, 6, 0);
        do setCell(11, 7, 0);
        do setCell(11, 8, 0);

        do setCell(11, 23, 0);
        do setCell(11, 24, 0);
        do setCell(11, 25, 0);

        do setCell(13, 6, 0);
        do setCell(13, 7, 0);
        do setCell(13, 8, 0);

        do setCell(13, 23, 0);
        do setCell(13, 24, 0);
        do setCell(13, 25, 0);

        do setCell(1, 29, 2);

        return;
    }

    method void draw(int cellSize) {
        var int r, c, x, y, value;
        var int mapWidth, mapHeight, offsetX, offsetY;

        let mapWidth = cols * cellSize;
        let mapHeight = rows * cellSize;

        let offsetX = (512 - mapWidth) / 2;
        let offsetY = (256 - mapHeight) / 2;

        let r = 0;
        while (r < rows) {
            let c = 0;
            while (c < cols) {
                let x = offsetX + (c * cellSize);
                let y = offsetY + (r * cellSize);
                let value = getCell(r, c);

                do Screen.setColor(false);
                do Screen.drawRectangle(x, y, x + cellSize - 1, y + cellSize - 1);

                if (value = 1) {
                    do Screen.setColor(true);
                    do Screen.drawRectangle(x + 1, y + 1, x + cellSize - 2, y + cellSize - 2);
                }

                if (value = 2) {
                    do Screen.setColor(true);
                    do Screen.drawRectangle(x + 3, y + 3, x + cellSize - 4, y + cellSize - 4);
                }

                let c = c + 1;
            }
            let r = r + 1;
        }

        return;
    }
}